# ==============================================================================
# Proxmox Host Power & Electricity Cost Tracker - Configuration
# ==============================================================================

# Cost per kilowatt-hour (kWh) in your local currency (e.g., USD, EUR, etc.)
# Check your parents' electricity bill for the exact rate per kWh.
COST_PER_KWH=0.25

# Absolute path to SQLite database file
DB_PATH=/data/energy_monitor.db

# Zigbee2MQTT Event WebSocket URL
# Zigbee2MQTT Frontend emits event messages on /api
Z2M_WS_URL=ws://localhost:8080/api

# Target Zigbee device friendly name or IEEE address.
# Set this to the friendly_name configured for your IKEA INSPELNING plug.
# If left empty, monitor.py will accept any device emitting 'power' and 'energy'.
DEVICE_FRIENDLY_NAME=proxmox-power-plug

# Minimum power change (in Watts) to trigger an immediate database record.
# Prevents writing micro-fluctuations (e.g., 42.1W -> 42.2W) while still capturing changes.
MIN_POWER_CHANGE_W=1.0

# Maximum seconds between database records when power draw is steady.
# Ensures periodic heartbeat logging even if load is completely constant.
MAX_INTERVAL_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
