#!/sbin/openrc-run
name="zigbee2mqtt"
description="Zigbee to MQTT bridge"

command="/usr/bin/npm"
command_args="start"
command_user="root"
directory="/opt/zigbee2mqtt"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need net mosquitto
}
